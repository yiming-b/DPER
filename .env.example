# Copy to .env or export these variables in your shell.
# The web UI also accepts an API key in the form for one run only.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cost-sensitive OpenAI default from the current GPT-5.6 family.
DPER_OPENAI_MODEL=gpt-5.6-luna

# Change this if your Anthropic account uses a different Claude model id.
DPER_CLAUDE_MODEL=claude-sonnet-4-5
